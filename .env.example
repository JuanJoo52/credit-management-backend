# Valores de ejemplo. Sustituir localmente; nunca usar credenciales reales en Git.
PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/credit_management?schema=public
DIRECT_URL=postgresql://app_user:replace_me@localhost:5432/credit_management?schema=public
# Solo requeridos por el mailer en NODE_ENV=production (Gmail).
EMAIL_USER=mailer@example.com
EMAIL_PASS=replace_with_gmail_app_password
